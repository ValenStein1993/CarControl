{
    "version": "2.0.0",
    "tasks": [
                {
                "label": "RunPreLaunchTasks",
                "type": "shell",
                "command": "bash",
                "args": [
                    "-c",
                    "${workspaceFolder}/Scripts/debug_sim.sh"
                ],
                "isBackground": true,
                "problemMatcher": {
                    "pattern": { "regexp": "." },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".",
                        "endsPattern": "Waiting for service|create.*become available|.*"
                    }
                },
                "presentation": {
                    "reveal": "always",
                    "panel": "shared"
                }
            }
    ]
}
 