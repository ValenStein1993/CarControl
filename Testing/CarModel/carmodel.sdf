<?xml version="1.0" ?>
<sdf version="1.8">
    <model name='car' canonical_link='chassis'>
        <link name='chassis'>
            <pose relative_to='__model__'>0 0 0.02 0 0 0</pose> 
            <inertial> 
                <mass>1.15</mass>
                <inertia>
                    <ixx>0.0006516666666666667</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.001657916666666667</iyy>
                    <iyz>0</iyz>
                    <izz>0.0022329166666666665</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                    <box>
                        <size>0.13 0.08 0.02</size>
                    </box>
                </geometry>
                <material>
                    <diffuse>0.0 0.0 1.0 1</diffuse>
                </material>
            </visual>
            <collision name='collision'>
                <geometry>
                    <box>
                        <size>0.13 0.08 0.02</size>
                    </box>
                </geometry>
            </collision>
            <sensor name="imu_sensor" type="imu">
                <pose relative_to='chassis'>0 0 0 0 0 0</pose>
                <imu>
                    <linear_acceleration>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.0</stddev>
                                <bias_mean>0.0</bias_mean>
                                <bias_stddev>0.000</bias_stddev>
                            </noise>
                        </x>
                    </linear_acceleration>
                    <angular_velocity>
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.01</stddev>
                                <bias_mean>0.0</bias_mean>
                                <bias_stddev>0.0</bias_stddev>
                            </noise>
                        </z>
                    </angular_velocity>
                </imu>
                <always_on>1</always_on>
                <update_rate>10</update_rate>
                <visualize>true</visualize>
                <topic>/imu_sensor</topic>
            </sensor>
            <sensor name='gpu_lidar' type='gpu_lidar'>
                <pose relative_to='chassis'>0 0 0.3 0 0 0</pose>
                <topic>/lidar_sensor</topic>
                <update_rate>10</update_rate>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>640</samples>
                            <resolution>1</resolution>
                            <min_angle>-1.396263</min_angle>
                            <max_angle>1.396263</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>1</samples>
                            <resolution>1</resolution>
                            <min_angle>0</min_angle>
                            <max_angle>0</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.1</min>
                        <max>100.0</max>
                        <resolution>0.1</resolution>
                    </range>
                </ray>
                <always_on>1</always_on>
                <visualize>true</visualize>
            </sensor>
        </link>
        <link name='front_chassis'>
            <pose relative_to='chassis'>0.085 0 0 0 0 0</pose>
            <visual name='visual'>
                <geometry>
                    <box>
                        <size>0.04 0.03 0.02</size>
                    </box>
                </geometry>
                <material>
                    <diffuse>0.0 0.0 1.0 1</diffuse>
                </material>
            </visual>
        </link>
        <link name='pos_front_axle'>
            <pose relative_to='front_chassis'>0.0050000000000000044 0 -0.005 0 0 0</pose>
        </link>
        <link name='front_axle'>
            <pose relative_to='pos_front_axle'>0 0 0 -1.5707 0 0</pose>
            <visual name='visual'>
                <geometry>
                    <cylinder>
                        <radius>0.002</radius>
                        <length>0.085</length>
                    </cylinder>
                </geometry>
                <material>
                    <diffuse>0.0 0.0 1.0 1</diffuse>
                </material>
            </visual>
        </link>
        <link name='pos_rear_axle'>
            <pose relative_to='chassis'>-0.05 0 -0.005 0 0 0</pose>
        </link>
        <link name='rear_axle'>
            <pose relative_to='pos_rear_axle'>0 0 0 -1.5707 0 0</pose>
            <visual name='visual'>
                <geometry>
                    <cylinder>
                        <radius>0.002</radius>
                        <length>0.085</length>
                    </cylinder>
                </geometry>
                <material>
                    <diffuse>0.0 0.0 1.0 1</diffuse>
                </material>
            </visual>
        </link>
        <link name='left_steering_link'>
            <pose relative_to="pos_front_axle">0 0.04 0 0 0 0</pose>
        </link>
        <link name='right_steering_link'>
            <pose relative_to="pos_front_axle">0 -0.04 0 0 0 0</pose>
        </link>
        <link name='left_frontwheel'>
            <pose relative_to="pos_front_axle">0 0.05 0 -1.5707 0 0</pose>
            <inertial>
                <mass>0.1</mass>
                <inertia>
                    <ixx>7.499999999999999e-06</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>7.499999999999999e-06</iyy>
                    <iyz>0</iyz>
                    <izz>1.125e-05</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                    <cylinder><radius>0.015</radius><length>0.015</length></cylinder>
                </geometry>
                <material><diffuse>1.0 0.0 0.0 1</diffuse></material>
            </visual>
            <collision name='collision'>
                <geometry>
                    <cylinder><radius>0.015</radius><length>0.015</length></cylinder>
                </geometry>
            </collision>
        </link>
        <link name='right_frontwheel'>
            <pose relative_to="pos_front_axle">0 -0.05 0 -1.5707 0 0</pose>
            <inertial>
                <mass>0.1</mass>
                <inertia>
                    <ixx>7.499999999999999e-06</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>7.499999999999999e-06</iyy>
                    <iyz>0</iyz>
                    <izz>1.125e-05</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                    <cylinder><radius>0.015</radius><length>0.015</length></cylinder>
                </geometry>
                <material><diffuse>1.0 0.0 0.0 1</diffuse></material>
            </visual>
            <collision name='collision'>
                <geometry>
                    <cylinder><radius>0.015</radius><length>0.015</length></cylinder>
                </geometry>
            </collision>
        </link>

        <link name='left_backwheel'>
            <pose relative_to="pos_rear_axle">0 0.05 0 -1.5707 0 0</pose>
            <inertial>
                <mass>0.1</mass>
                <inertia>
                    <ixx>7.499999999999999e-06</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>7.499999999999999e-06</iyy>
                    <iyz>0</iyz>
                    <izz>1.125e-05</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                    <cylinder>
                        <radius>0.015</radius>
                        <length>0.015</length>
                    </cylinder>
                </geometry>
                <material>
                    <diffuse>1.0 0.0 0.0 1</diffuse>
                </material>
            </visual>
            <collision name='collision'>
                <geometry>
                    <cylinder>
                        <radius>0.015</radius>
                        <length>0.015</length>
                    </cylinder>
                </geometry>
            </collision>
        </link>

        <link name='right_backwheel'>
            <pose relative_to="pos_rear_axle">0 -0.05 0 -1.5707 0 0</pose>
            <inertial>
                <mass>0.1</mass>
                <inertia>
                    <ixx>7.499999999999999e-06</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>7.499999999999999e-06</iyy>
                    <iyz>0</iyz>
                    <izz>1.125e-05</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                    <cylinder>
                        <radius>0.015</radius>
                        <length>0.015</length>
                    </cylinder>
                </geometry>
                <material>
                    <diffuse>1.0 0.0 0.0 1</diffuse>
                </material>
            </visual>
            <collision name='collision'>
                <geometry>
                    <cylinder>
                        <radius>0.015</radius>
                        <length>0.015</length>
                    </cylinder>
                </geometry>
            </collision>
        </link>
        <joint name="front_chassis_joint" type="fixed">
            <parent>chassis</parent>
            <child>front_chassis</child>
        </joint>
        <joint name="front_axle_joint" type="fixed">
            <parent>front_chassis</parent>
            <child>front_axle</child>
        </joint>
        <joint name='left_steering_joint' type='revolute'>
            <pose relative_to='left_steering_link'/>
            <parent>front_chassis</parent>
            <child>left_steering_link</child>
            <axis>
                <xyz expressed_in='__model__'>0 0 1</xyz>
                <limit>
                    <lower>-0.6</lower>  <!-- ~34 degrees -->
                    <upper>0.6</upper>
                    <effort>10</effort> 
                </limit>
            </axis>
        </joint>

        <joint name='right_steering_joint' type='revolute'>
            <pose relative_to='right_steering_link'/>
            <parent>front_chassis</parent>
            <child>right_steering_link</child>
            <axis>
                <xyz expressed_in='__model__'>0 0 1</xyz>
                <limit>
                    <lower>-0.6</lower>
                    <upper>0.6</upper>
                    <effort>10</effort> 
                </limit>
            </axis>
        </joint>

        <joint name='left_frontwheel_joint' type='revolute'>
            <pose relative_to='left_frontwheel'/>
            <parent>left_steering_link</parent>
            <child>left_frontwheel</child>
            <axis>
                <xyz expressed_in='__model__'>0 1 0</xyz>
            </axis>
        </joint>

        <joint name='right_frontwheel_joint' type='revolute'>
            <pose relative_to='right_frontwheel'/>
            <parent>right_steering_link</parent>
            <child>right_frontwheel</child>
            <axis>
                <xyz expressed_in='__model__'>0 1 0</xyz>
            </axis>
        </joint>

        <joint name='left_backwheel_joint' type='revolute'>
            <pose relative_to='left_backwheel'/>
            <parent>chassis</parent>
            <child>left_backwheel</child>
            <axis>
                <xyz expressed_in='__model__'>0 1 0</xyz>
                <limit>
                    <effort>10</effort>
                </limit>
            </axis>
        </joint>

        <joint name='right_backwheel_joint' type='revolute'>
            <pose relative_to='right_backwheel'/>
            <parent>chassis</parent>
            <child>right_backwheel</child>
            <axis>
                <xyz expressed_in='__model__'>0 1 0</xyz>
                <limit>
                    <effort>10</effort>
                </limit>
            </axis>
        </joint>
        <plugin
            filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
            <left_joint>left_backwheel_joint</left_joint>
            <right_joint>right_backwheel_joint</right_joint>
            <left_steering_joint>left_steering_joint</left_steering_joint>
            <right_steering_joint>right_steering_joint</right_steering_joint>
            <kingpin_width>0.08</kingpin_width>       <!-- matches wheel_separation -->
            <steering_limit>0.6</steering_limit>     <!-- must match joint limits -->
            <wheel_base>0.14</wheel_base>             <!-- distance front to rear axle -->
            <wheel_separation>0.1</wheel_separation>
            <wheel_radius>0.015</wheel_radius>
            <odom_publish_frequency>10</odom_publish_frequency>
            <topic>cmd_vel</topic>
        </plugin>
        <plugin
            filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
            <publish_model_pose>true</publish_model_pose>
            <update_frequency>10</update_frequency>
        </plugin>
        <plugin 
            filename="libgazebo_msg_bridge.so"
            name="MessageBridge">
        </plugin>
        <plugin 
            filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
        </plugin>
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <joint_name>left_backwheel_joint</joint_name>
            <joint_name>right_backwheel_joint</joint_name>
            <joint_name>left_steering_joint</joint_name>
            <joint_name>right_steering_joint</joint_name>
            <topic>/wheel_states</topic>
        </plugin>
    </model>
</sdf>