<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="maze_world_demo">

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
    </scene>

    <!-- 6x6 maze, 0.45m cell pitch. Entry (green) is the south side of
         the southwest corner cell; exit (red) is the north side of the
         northeast corner cell. Generated with a randomized recursive
         backtracker (seed 32); the unique solution path is 24 cells
         long, so it's a real maze, not a straight shot. -->

    <model name="white_floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="floor_link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3 3</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3 3</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.92 0.92 0.9 1</ambient>
            <diffuse>0.95 0.95 0.93 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_h_0_0">
      <static>true</static>
      <link name="link">
        <pose>-1.125 1.35 0.2 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.45 0.02 0.4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.45 0.02 0.4</size></box></geometry>
          <material>
            <ambient>0.18 0.32 0.5 1</ambient>
            <diffuse>0.22 0.38 0.58 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

